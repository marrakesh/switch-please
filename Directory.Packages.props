<Project>
  <PropertyGroup>
    <!--
      Package versions live here rather than in each project file, so a bump is one edit and
      two projects can never end up on different versions of the same package by accident.
    -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Still xunit v2 on purpose. Version 3 builds here and every one of these tests passes
      under it, but it speaks only Microsoft.Testing.Platform, and on this SDK `dotnet test`
      hands that runner the test assembly in a way it answers with "zero tests ran"; the
      tests run only by executing the test project directly. A working `dotnet test` is what
      CI and CONTRIBUTING both rely on, and that is worth more than a newer major version.
      Revisit when the SDK and the runner agree.
    -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
